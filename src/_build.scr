#! /usr/bin/env bash
set -e
umask 022
exec < /dev/null

#GCC_PACKAGE=gcc-4.5-2011.03
#BINUTILS_PACKAGE=binutils-2011.03
GCC_PACKAGE=gcc-4.4-2010q1
BINUTILS_PACKAGE=binutils-2010q1

unset BASH_ENV CDPATH POSIXLY_CORRECT TMOUT
export LANG=C
export LC_ALL=C
user_shell=$SHELL
export SHELL=$BASH
export CONFIG_SHELL=$BASH

export STRIP=strip
export WRK_DIR=`pwd`
export OBJ=${WRK_DIR}/obj
export OBJ_INSTALL=${WRK_DIR}/../arm-2010q1
export HOST_LIBS=${OBJ}/host-libs/usr

export AR_FOR_TARGET=arm-uclinuxeabi-ar
export NM_FOR_TARGET=arm-uclinuxeabi-nm
export OBJDUMP_FOR_TARET=arm-uclinuxeabi-objdump
export STRIP_FOR_TARGET=arm-uclinuxeabi-strip
export CC_FOR_BUILD=gcc-4.3
export CC=gcc-4.3
export CXX=g++-4.3
export AR=ar
export RANLIB=ranlib
export PATH=$PATH:$OBJ_INSTALL/bin

rm -rf ${OBJ} ../tools/arm-2010q1
mkdir -p ${OBJ} ${OBJ_INSTALL} ${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/{html,pdf}

pushd ${OBJ}
COMMON_FLAGS="--build=i686-pc-linux-gnu --prefix=${HOST_LIBS} --host=i686-pc-linux-gnu --disable-nls"
for package in zlib-1.2.3 gmp-2011.03 mpfr-2010q1 ppl-0.10.2 mpc-0.8.1 cloog-0.15 ${BINUTILS_PACKAGE} elf2flt-2006q1 libelf-2011.03
do
  echo +++ `date +%T` $package
  tar -zxpf ../${package}.tgz
  cd $package 
  case $package in
    zlib-1.2.3) (AR='ar rc'; ./configure --prefix=${HOST_LIBS} --host=i686-pc-linux-gnu --disable-nls); make -j4; make install;;  #
    gmp-2011.03) (CFLAGS='-g -O2'; ./configure $COMMON_FLAGS --enable-cxx ); make -j4; make install; make check;;
    mpfr-2010q1) ./configure $COMMON_FLAGS --target=arm-uclinuxeabi --with-gmp=${HOST_LIBS}; make -j4; make install; make check;;
    ppl-0.10.2)  ./configure $COMMON_FLAGS --target=arm-uclinuxeabi --with-libgmp-prefix=${HOST_LIBS}; make -j4; make install;;
    mpc-0.8.1)   ./configure $COMMON_FLAGS --target=arm-uclinuxeabi --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS}; make -j4; make install; make check;;
    cloog-0.15)  ./configure $COMMON_FLAGS --target=arm-uclinuxeabi --with-ppl=${HOST_LIBS} --with-gmp=${HOST_LIBS}; make -j4; make install; make check;;
    libelf-2011.03) ./configure $COMMON_FLAGS --target=arm-uclinuxeabi; make -j4; make install;;
    ${BINUTILS_PACKAGE}) touch .gnu-stamp;
(export CPPFLAGS=-I${HOST_LIBS}/include; export LDFLAGS=-L${HOST_LIBS}/lib;
./configure --build=i686-pc-linux-gnu --target=arm-uclinuxeabi --prefix=/opt/emcraft --host=i686-pc-linux-gnu --enable-install-libbfd --disable-nls --with-sysroot=/opt/emcraft/arm-uclinuxeabi/libc --enable-poison-system-directories
make -j4
make install prefix=${OBJ_INSTALL} exec_prefix=${OBJ_INSTALL} libdir=${OBJ_INSTALL}/lib htmldir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/html pdfdir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/pdf infodir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/info mandir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/man datadir=${OBJ_INSTALL}/share
rm -f ${OBJ_INSTALL}/lib/libiberty.a; CPPFLAGS=; LDFLAGS=;);;
    elf2flt-2006q1) 
./configure --build=i686-pc-linux-gnu --target=arm-uclinuxeabi --prefix=/opt/emcraft --host=i686-pc-linux-gnu --disable-nls --with-bfd-include-dir=${OBJ_INSTALL}/i686-pc-linux-gnu/arm-uclinuxeabi/include --with-libbfd=${OBJ_INSTALL}/i686-pc-linux-gnu/arm-uclinuxeabi/lib/libbfd.a --with-binutils-include-dir=${OBJ}/${BINUTILS_PACKAGE}/include --with-zlib-prefix=${HOST_LIBS} --with-libiberty=${OBJ}/${BINUTILS_PACKAGE}/libiberty/libiberty.a
make -j4
make install prefix=${OBJ_INSTALL} exec_prefix=${OBJ_INSTALL} libdir=${OBJ_INSTALL}/lib htmldir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/html pdfdir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/pdf infodir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/info mandir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/man datadir=${OBJ_INSTALL}/share;;
    default) ;;
  esac;
  cd ..;
done
popd

echo +++ `date +%T` install_kernel_headers_uclibc
pushd ${WRK_DIR}/../../linux;
make ARCH=arm CROSS_COMPILE= INSTALL_HDR_PATH=${OBJ_INSTALL}/arm-uclinuxeabi/libc/usr headers_install
popd

echo +++ `date +%T` make lib dirs
mkdir -p ${OBJ_INSTALL}/arm-uclinuxeabi/libc/{.,armv6-m,armv6-m/lib,armv6-m/usr/lib,thumb2,thumb2/lib,thumb2/usr/lib,lib,usr/lib}

pushd ${OBJ}; tar -zxpf ../${GCC_PACKAGE}.tgz; popd;

echo +++ `date +%T` gcc_first/configure_build
rm -rf ${OBJ}/gcc-first; mkdir -p ${OBJ}/gcc-first; pushd ${OBJ}/gcc-first
#${OBJ}/${GCC_PACKAGE}/configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu --target=arm-uclinuxeabi --enable-threads --disable-libmudflap --disable-libssp --disable-libstdcxx-pch --enable-extra-sgxxlite-multilibs --with-gnu-as --with-gnu-ld '--with-specs=%{O2:%{!fno-remove-local-statics: -fremove-local-statics}} %{O*:%{O|O0|O1|O2|Os:;:%{!fno-remove-local-statics: -fremove-local-statics}}}' --enable-languages=c,c++ --disable-shared --disable-lto --disable-nls --prefix=/opt/emcraft --disable-shared --disable-threads --disable-libssp --disable-libgomp --without-headers --with-newlib --disable-decimal-float --disable-libffi --enable-languages=c --with-sysroot=/opt/emcraft/arm-uclinuxeabi/libc --with-build-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS} --with-ppl=${HOST_LIBS} '--with-host-libstdcxx=-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-cloog=${HOST_LIBS} --disable-libgomp --enable-poison-system-directories --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin
#make -j4 LDFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc CPPFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc build_tooldir=${OBJ_INSTALL}/arm-uclinuxeabi
#make prefix=${OBJ_INSTALL} exec_prefix=${OBJ_INSTALL} libdir=${OBJ_INSTALL}/lib htmldir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/html pdfdir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/pdf infodir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/info mandir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/man install
#popd


${OBJ}/${GCC_PACKAGE}/configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu --target=arm-uclinuxeabi --enable-threads --disable-libmudflap --disable-libssp --disable-libstdcxx-pch --enable-extra-sgxxlite-multilibs --with-gnu-as --with-gnu-ld '--with-specs=%{save-temps: -fverbose-asm} -D__CS_SOURCERYGXX_MAJ__=2011 -D__CS_SOURCERYGXX_MIN__=3 -D__CS_SOURCERYGXX_REV__=46 %{O2:%{!fno-remove-local-statics: -fremove-local-statics}} %{O*:%{O|O0|O1|O2|Os:;:%{!fno-remove-local-statics: -fremove-local-statics}}}' --enable-languages=c,c++ --disable-shared --enable-lto '--with-pkgversion=Sourcery G++ Lite 2011.03-46' --disable-nls --prefix=${OBJ_INSTALL} --disable-shared --disable-threads --disable-libssp --disable-libgomp --without-headers --with-newlib --disable-decimal-float --disable-libffi --disable-libquadmath --enable-languages=c --with-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-build-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS} --with-mpc=${HOST_LIBS} --with-ppl=${HOST_LIBS} '--with-host-libstdcxx=-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-cloog=${HOST_LIBS} --with-libelf=${HOST_LIBS} --disable-libgomp --enable-poison-system-directories --with-build-time-tools=${YOR_INSTALL}/arm-uclinuxeabi/bin 
make -j4 LDFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc CPPFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc build_tooldir=${OBJ_INSTALL}/arm-uclinuxeabi
make prefix=${OBJ_INSTALL} exec_prefix=${OBJ_INSTALL} libdir=${OBJ_INSTALL}/lib htmldir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/html pdfdir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/pdf infodir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/info mandir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/man install
popd

echo +++ `date +%T` /i686-pc-linux-gnu/toolchain/gcc_first/postinstall
rm -f ${OBJ_INSTALL}/bin/arm-uclinuxeabi-gccbug ${OBJ_INSTALL}/lib/libiberty.a
rm -rf ${OBJ_INSTALL}/include

echo +++ `date +%T` uclibc_0
pushd ${OBJ}; tar -zxpf ../uclibc-2011.03.tgz; mv uclibc-2011.03 uclibc.default; cd uclibc.default
cp -f default.config .config
yes "" | make oldconfig
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS= ' headers
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS= ' PREFIX=${OBJ_INSTALL}/arm-uclinuxeabi/libc/. install_headers
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS= ' lib/crt1.o lib/crti.o lib/crtn.o
cp lib/{crt1.o,crti.o,crtn.o} ${OBJ_INSTALL}/arm-uclinuxeabi/libc/usr/lib/
popd

echo +++ `date +%T` uclibc_1
pushd ${OBJ}; tar -zxpf ../uclibc-2011.03.tgz; mv uclibc-2011.03 uclibc.mthumb-march_armv6-m; cd uclibc.mthumb-march_armv6-m
cp -f mthumb-march_armv6-m.config .config
yes "" | make oldconfig
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv6-m ' headers
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv6-m ' PREFIX=${OBJ_INSTALL}/arm-uclinuxeabi/libc/armv6-m install_headers
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv6-m ' lib/crt1.o lib/crti.o lib/crtn.o
cp lib/{crt1.o,crti.o,crtn.o} ${OBJ_INSTALL}/arm-uclinuxeabi/libc/armv6-m/usr/lib/
popd

echo +++ `date +%T` uclibc_2
pushd ${OBJ}; tar -zxpf ../uclibc-2011.03.tgz; mv uclibc-2011.03 uclibc.mthumb-march_armv7-mfix-cortex-m3-ldrd; cd uclibc.mthumb-march_armv7-mfix-cortex-m3-ldrd
cp -f mthumb-march_armv7-mfix-cortex-m3-ldrd.config .config
yes "" | make oldconfig
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv7 -mfix-cortex-m3-ldrd ' headers
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv7 -mfix-cortex-m3-ldrd ' PREFIX=${OBJ_INSTALL}/arm-uclinuxeabi/libc/thumb2 install_headers
make V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv7 -mfix-cortex-m3-ldrd ' lib/crt1.o lib/crti.o lib/crtn.o
cp lib/{crt1.o,crti.o,crtn.o} ${OBJ_INSTALL}/arm-uclinuxeabi/libc/thumb2/usr/lib/
popd

echo +++ `date +%T` gcc_second
rm -rf ${OBJ}/gcc-second; mkdir -p ${OBJ}/gcc-second; pushd ${OBJ}/gcc-second
${OBJ}/${GCC_PACKAGE}/configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu --target=arm-uclinuxeabi --enable-threads --disable-libmudflap --disable-libssp --disable-libstdcxx-pch --enable-extra-sgxxlite-multilibs --with-gnu-as --with-gnu-ld '--with-specs=%{O2:%{!fno-remove-local-statics: -fremove-local-statics}} %{O*:%{O|O0|O1|O2|Os:;:%{!fno-remove-local-statics: -fremove-local-statics}}}' --enable-languages=c,c++ --disable-shared --disable-lto --disable-nls --enable-languages=c --disable-libffi --with-build-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS} --with-ppl=${HOST_LIBS} '--with-host-libstdcxx=-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-cloog=${HOST_LIBS} --disable-libgomp --enable-poison-system-directories --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin
${OBJ}/${GCC_PACKAGE}/configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu --target=arm-uclinuxeabi --enable-threads --disable-libmudflap --disable-libssp --disable-libstdcxx-pch --enable-extra-sgxxlite-multilibs --with-gnu-as --with-gnu-ld '--with-specs=%{O2:%{!fno-remove-local-statics: -fremove-local-statics}} %{O*:%{O|O0|O1|O2|Os:;:%{!fno-remove-local-statics: -fremove-local-statics}}}' --enable-languages=c,c++ --disable-shared --disable-lto --disable-nls --prefix=/opt/emcraft --enable-languages=c --disable-libffi --with-sysroot=/opt/emcraft/arm-uclinuxeabi/libc --with-build-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS} --with-ppl=${HOST_LIBS} '--with-host-libstdcxx=-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-cloog=${HOST_LIBS} --disable-libgomp --enable-poison-system-directories --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin
make -j4 LDFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc CPPFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc build_tooldir=${OBJ_INSTALL}/arm-uclinuxeabi
make prefix=${OBJ_INSTALL} exec_prefix=${OBJ_INSTALL} libdir=${OBJ_INSTALL}/lib htmldir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/html pdfdir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/pdf infodir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/info mandir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/man install
popd

echo +++ `date +%T` gcc_second/postinstall
rm ${OBJ_INSTALL}/bin/arm-uclinuxeabi-gccbug ${OBJ_INSTALL}/lib/libiberty.a
rmdir ${OBJ_INSTALL}/include

echo +++ `date +%T` uclibc_0
make -C ${OBJ}/uclibc.default V=1 ARCH_CFLAGS= 'CPU_CFLAGS= '
make -C ${OBJ}/uclibc.default V=1 ARCH_CFLAGS= 'CPU_CFLAGS= ' PREFIX=${OBJ_INSTALL}/arm-uclinuxeabi/libc/. install

echo +++ `date +%T` uclibc_1
make -C ${OBJ}/uclibc.mthumb-march_armv6-m V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv6-m '
make -C ${OBJ}/uclibc.mthumb-march_armv6-m V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv6-m ' PREFIX=${OBJ_INSTALL}/arm-uclinuxeabi/libc/armv6-m install

echo +++ `date +%T` uclibc_2
make -C ${OBJ}/uclibc.mthumb-march_armv7-mfix-cortex-m3-ldrd V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv7 -mfix-cortex-m3-ldrd '
make -C ${OBJ}/uclibc.mthumb-march_armv7-mfix-cortex-m3-ldrd V=1 ARCH_CFLAGS= 'CPU_CFLAGS=-mthumb -march=armv7 -mfix-cortex-m3-ldrd ' PREFIX=${OBJ_INSTALL}/arm-uclinuxeabi/libc/thumb2 install

echo +++ `date +%T` gcc
rm -rf ${OBJ}/gcc-2010q1; mkdir -p ${OBJ}/gcc-2010q1; pushd ${OBJ}/gcc-2010q1
${OBJ}/${GCC_PACKAGE}/configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu --target=arm-uclinuxeabi --enable-threads --disable-libmudflap --disable-libssp --disable-libstdcxx-pch --enable-extra-sgxxlite-multilibs --with-gnu-as --with-gnu-ld '--with-specs=%{O2:%{!fno-remove-local-statics: -fremove-local-statics}} %{O*:%{O|O0|O1|O2|Os:;:%{!fno-remove-local-statics: -fremove-local-statics}}}' --enable-languages=c,c++ --disable-shared --disable-lto --disable-nls --with-build-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS} --with-ppl=${HOST_LIBS} '--with-host-libstdcxx=-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-cloog=${HOST_LIBS} --disable-libgomp --enable-poison-system-directories --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin
${OBJ}/${GCC_PACKAGE}/configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu --target=arm-uclinuxeabi --enable-threads --disable-libmudflap --disable-libssp --disable-libstdcxx-pch --enable-extra-sgxxlite-multilibs --with-gnu-as --with-gnu-ld '--with-specs=%{O2:%{!fno-remove-local-statics: -fremove-local-statics}} %{O*:%{O|O0|O1|O2|Os:;:%{!fno-remove-local-statics: -fremove-local-statics}}}' --enable-languages=c,c++ --disable-shared --disable-lto --disable-nls --prefix=/opt/emcraft --with-sysroot=/opt/emcraft/arm-uclinuxeabi/libc --with-build-sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc --with-gmp=${HOST_LIBS} --with-mpfr=${HOST_LIBS} --with-ppl=${HOST_LIBS} '--with-host-libstdcxx=-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-cloog=${HOST_LIBS} --disable-libgomp --enable-poison-system-directories --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin --with-build-time-tools=${OBJ_INSTALL}/arm-uclinuxeabi/bin
make -j4 LDFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc CPPFLAGS_FOR_TARGET=--sysroot=${OBJ_INSTALL}/arm-uclinuxeabi/libc build_tooldir=${OBJ_INSTALL}/arm-uclinuxeabi
make prefix=${OBJ_INSTALL} exec_prefix=${OBJ_INSTALL} libdir=${OBJ_INSTALL}/lib htmldir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/html pdfdir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/pdf infodir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/info mandir=${OBJ_INSTALL}/share/doc/arm-arm-uclinuxeabi/man install
popd

echo +++ `date +%T` gcc_final
rm ${OBJ_INSTALL}/bin/arm-uclinuxeabi-gccbug
rm ${OBJ_INSTALL}/./arm-uclinuxeabi/lib/armv6-m/libiberty.a ${OBJ_INSTALL}/./arm-uclinuxeabi/lib/thumb2/libiberty.a ${OBJ_INSTALL}/./arm-uclinuxeabi/lib/libiberty.a ${OBJ_INSTALL}/./lib/libiberty.a
rmdir ${OBJ_INSTALL}/include

echo +++ `date +%T` zlib-1.2.3
pushd ${OBJ}; rm -rf zlib-1.2.3; tar -zxpf ../zlib-1.2.3.tgz; cd zlib-1.2.3;
(AR='ar rc'; ./configure --prefix=${HOST_LIBS}); make -j4; make install; 
popd

echo +++ `date +%T` expat-mirror
#### do not use --prefix since puts in separate opt dir?
pushd ${OBJ}; rm -rf expat-mirror; tar -zxpf ../expat-mirror.tgz; cd expat-mirror;
./configure --build=i686-pc-linux-gnu --target=arm-uclinuxeabi --prefix=/tools/arm-2010q1 --disable-shared --host=i686-pc-linux-gnu --disable-nls; make -j4; make install; 
popd

echo +++ `date +%T` finalize_libc_installation
cp -d ${OBJ_INSTALL}/arm-uclinuxeabi/lib/libstdc++.a ${OBJ_INSTALL}/arm-uclinuxeabi/libc/usr/lib
cp -d ${OBJ_INSTALL}/arm-uclinuxeabi/lib/armv6-m/libstdc++.a ${OBJ_INSTALL}/arm-uclinuxeabi/libc/armv6-m/usr/lib/
cp -d ${OBJ_INSTALL}/arm-uclinuxeabi/lib/thumb2/libstdc++.a ${OBJ_INSTALL}/arm-uclinuxeabi/libc/thumb2/usr/lib/
rm -rf ${OBJ_INSTALL}/arm-uclinuxeabi/libc/thumb2/usr/include
rm -rf ${OBJ_INSTALL}/arm-uclinuxeabi/libc/armv6-m/usr/include

echo +++ `date +%T` cleanup
rm -f ${OBJ_INSTALL}/lib/libiberty.a
find ${OBJ_INSTALL} -name '*.la' -exec rm '{}' ';'
rm -f ${OBJ_INSTALL}/arm-uclinuxeabi/lib/{libstdc++.a,armv6-m/libstdc++.a,thumb2/libstdc++.a}

rm -rf ${OBJ_INSTALL}/share

echo +++ `date +%T` /i686-pc-linux-gnu/strip_host_objects
for f in ${OBJ_INSTALL}/bin/* ${OBJ_INSTALL}/arm-uclinuxeabi/bin/* ${OBJ_INSTALL}/libexec/gcc/arm-uclinuxeabi/4.4.1/{cc1,collect2,cc1plus} ${OBJ_INSTALL}/libexec/gcc/arm-uclinuxeabi/4.4.1/install-tools/fixincl
do
  ${STRIP} $f
done

# cross-gdb and gdbserver
pushd ${OBJ}; tar -zxpf ../gdb-2011.03.tgz; cd gdb-2011.03
CC_FOR_BUILD="/usr/bin/gcc -B/usr/bin/" CC="/usr/bin/gcc -B/usr/bin/ -m32" ./configure --build=i686-linux --target=arm-uclinuxeabi --disable-sim --disable-tui --with-expat=yes
make -s
install -m 755 gdb/gdb ${OBJ_INSTALL}/bin/arm-uclinuxeabi-gdb
strip ${OBJ_INSTALL}/bin/arm-uclinuxeabi-gdb
#make distclean
popd

# mkimage
pushd ${OBJ}; tar -zxpf ../mkimage.tgz;
mkdir -p ${OBJ_INSTALL}/bin
cp -f mkimage/mkimage ${OBJ_INSTALL}/bin
popd

echo +++ `date +%T` /i686-pc-linux-gnu/strip_target_objects
STRIP_CMD="-R .comment -R .note -R .debug_info -R .debug_aranges -R .debug_pubnames -R .debug_abbrev -R .debug_line -R .debug_str -R .debug_ranges -R .debug_loc"
for f in ${OBJ_INSTALL}/arm-uclinuxeabi/libc/armv6-m/usr/lib/{*.a,*.o} ${OBJ_INSTALL}/arm-uclinuxeabi/libc/usr/lib/{*.a,*.o} ${OBJ_INSTALL}/arm-uclinuxeabi/libc/thumb2/usr/lib/{*.a,*.o} ${OBJ_INSTALL}/arm-uclinuxeabi/lib/libsupc++.a ${OBJ_INSTALL}/arm-uclinuxeabi/lib/armv6-m/libsupc++.a ${OBJ_INSTALL}/arm-uclinuxeabi/lib/thumb2/libsupc++.a ${OBJ_INSTALL}/lib/gcc/arm-uclinuxeabi/4.4.1/{*.a,*.o}
do
  arm-uclinuxeabi-objcopy ${STRIP_CMD} $f
done

echo +++ `date +%T` /i686-pc-linux-gnu/add_tooldir_readme
cat > ${OBJ_INSTALL}/arm-uclinuxeabi/bin/README.txt <<'EOF0'
The executables in this directory are for internal use by the compiler and may not operate correctly when used directly.  This directory
should not be placed on your PATH.  Instead, you should use the executables in ../../bin/ and place that directory on your PATH.
EOF0

echo "DONE."
